{
  "manifest_version": 3,
  "name": "CyberAware AI - Kiểm tra trang, Gmail và nội dung chọn",
  "version": "1.3.1",
  "description": "Chủ động kiểm tra trang web, thư Gmail hoặc nội dung được chọn bằng chuột phải.",
  "minimum_chrome_version": "116",
  "action": { "default_popup": "popup.html", "default_title": "Kiểm tra với CyberAware" },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "sidePanel"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "host_permissions": ["https://cyberaware.click/*"]
}
